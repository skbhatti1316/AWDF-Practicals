# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/taskmanager?retryWrites=true&w=majority

# Express Server Port (defaults to 5000 as per Practical 6 manual)
PORT=5000

# JSON Web Token secret key for authentication (Practical 7)
JWT_SECRET=your_jwt_secret_key_here
